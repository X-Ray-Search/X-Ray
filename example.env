# X-Ray configuration. Copy to `.env` (Bun loads it automatically) or pass as container env vars.
# Everything instance-level beyond this (access mode, engines, proxies, AI, bangs) is configured
# in the admin UI and stored in the database.

XRAY_LOG_LEVEL=info

# Public URL of this instance (used for links in emails and the initial admin reset link).
XRAY_APP_URL=http://localhost:12418

XRAY_API_DISABLE_DOCS=false

XRAY_DB_PATH=./data/db.sqlite
XRAY_DB_AUTO_MIGRATE=true

XRAY_LOG_DIR=./data/logs
XRAY_CONFIG_BASE_DIR=./config

# Set to true when X-Ray runs behind a reverse proxy that sets X-Forwarded-For / X-Real-IP.
XRAY_TRUST_PROXY=false

# Do not download the DuckDuckGo bang dataset automatically (offline setups).
XRAY_BANGS_DISABLE_AUTO_FETCH=false

# Optional SMTP for password reset emails.
XRAY_SMTP_HOST=
XRAY_SMTP_PORT=465
XRAY_SMTP_USERNAME=
XRAY_SMTP_PASSWORD=
XRAY_SMTP_FROM='"X-Ray" <noreply@xray.example.com>'
XRAY_SMTP_SECURE=true
